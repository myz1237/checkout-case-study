# Checkout.com sandbox credentials (Dashboard > Developers > Keys)
CKO_SECRET_KEY=sk_sbox_xxx
CKO_PROCESSING_CHANNEL_ID=pc_xxx
# Public key is safe to expose to the browser; Flow needs it client-side
NEXT_PUBLIC_CKO_PUBLIC_KEY=pk_sbox_xxx
# sandbox | production
NEXT_PUBLIC_CKO_ENVIRONMENT=sandbox
# Optional: public origin used for success/failure redirect URLs when running behind a proxy.
# Vercel and local dev do not need it.
# SITE_URL=https://your-shop.example
